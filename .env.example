# ═══════════════════════════════════════════════════════════════════════════
# CodelithLabs — Environment Variables
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ─── NextAuth.js (Auth.js v5) ────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://codelithlabs.in

# ─── Google OAuth ─────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Razorpay ─────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── SendGrid (Contact Form) ──────────────────────────────────────────────
# Dashboard: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@codelithlabs.in
CONTACT_EMAIL=team.codelithlabs@gmail.com

# ─── Cloudflare Turnstile (Spam Protection) ──────────────────────────────
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Google Analytics (GA4) ───────────────────────────────────────────────
# Measurement ID from: https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID=

# ─── Google AdSense ───────────────────────────────────────────────────────
# Publisher ID from: https://www.google.com/adsense
NEXT_PUBLIC_ADSENSE_ID=

# ─── ConvertKit (Newsletter) ──────────────────────────────────────────────
# Dashboard: https://app.convertkit.com/account/edit
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# ─── Redis (Rate Limiting) ────────────────────────────────────────────────
# Optional — falls back to in-memory if not set
REDIS_URL=

# ─── Giscus (Blog Comments) ───────────────────────────────────────────────
# Configure at: https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=CodelithLabs/codelithlabs-web
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ─── IndexNow (Search Engine URL Submission) ──────────────────────────────
# Your unique API key for IndexNow protocol
# Key file must be hosted at: https://codelithlabs.in/YOUR_KEY.txt
# Get key at: https://www.bing.com/indexnow
INDEXNOW_API_KEY=4b7800bbc0ca4c9682d90291a3cbd355

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://codelithlabs.in
