# ═══════════════════════════════════════════════════════════════════════════
# CodelithLabs — Environment Variables
# Copy this file to .env.local and fill in your values
# CRITICAL: Never commit .env.local to version control
# ═══════════════════════════════════════════════════════════════════════════

# ─── NextAuth.js (Auth.js v5) - REQUIRED ──────────────────────────────────
# Generate a strong secret: openssl rand -base64 33
# Min length: 16 chars | This must be set in production
NEXTAUTH_SECRET=your-random-secret-min-32-characters-long

# Application URL for OAuth callbacks (required in production)
NEXTAUTH_URL=https://codelithlabs.in

# ─── Google OAuth - REQUIRED ──────────────────────────────────────────────
# Setup: https://console.cloud.google.com/apis/credentials
# Required for user authentication
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── Razorpay - REQUIRED for payments ──────────────────────────────────────
# Dashboard: https://dashboard.razorpay.com/app/keys
# Use: rzp_test_* for development, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── SendGrid - REQUIRED for contact form ──────────────────────────────────
# API Key: https://app.sendgrid.com/settings/api_keys
# Must have 'Mail Send' permission
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@codelithlabs.in

# ─── Cloudflare Turnstile (CAPTCHA) - REQUIRED ────────────────────────────
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key: Safe to expose in client code
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Secret key: Must keep private (server-side only)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── ConvertKit (Newsletter) - REQUIRED ────────────────────────────────────
# Setup: https://app.convertkit.com/account/edit
CONVERTKIT_API_KEY=your-convertkit-api-key
CONVERTKIT_FORM_ID=your-form-id-number

# ─── Redis (Rate Limiting & Caching) - OPTIONAL ─────────────────────────────
# Format: redis://[user:password@]host:port[/db]
# If not set: Falls back to in-memory rate limiting (dev only, not production-safe)
# Example: redis://default:password@localhost:6379/0
# REDIS_URL=

# ─── Google Analytics (GA4) - OPTIONAL ─────────────────────────────────────
# Measurement ID from: https://analytics.google.com
# NEXT_PUBLIC_GA_ID=G-your-measurement-id

# ─── Microsoft Clarity (Session Recording) - OPTIONAL ─────────────────────
# Project ID from: https://clarity.microsoft.com
# NEXT_PUBLIC_CLARITY_ID=

# ─── Google AdSense - OPTIONAL ────────────────────────────────────────────
# Publisher ID from: https://www.google.com/adsense
# NEXT_PUBLIC_ADSENSE_ID=

# ─── Environment Detection - AUTO-DETECTED ────────────────────────────────
# NODE_ENV=development (local) | production (Vercel) | test (npm run test:run)
# Normally set by build system, not in .env
# NODE_ENV=development
# Configure at: https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=CodelithLabs/codelithlabs-web
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ─── IndexNow (Search Engine URL Submission) ──────────────────────────────
# Your unique API key for IndexNow protocol
# Key file must be hosted at: https://codelithlabs.in/YOUR_KEY.txt
# Get key at: https://www.bing.com/indexnow
INDEXNOW_API_KEY=4b7800bbc0ca4c9682d90291a3cbd355

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://codelithlabs.in
