generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  image             String?
  isPremium         Boolean   @default(false)
  premiumActivatedAt DateTime?
  premiumExpiresAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payments          Payment[]
  webhookEvents     WebhookEvent[]
  analyticsEvents   AnalyticsEvent[]
}

model Payment {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String       @default("razorpay")
  planCode          String       @default("premium_monthly")

  razorpayOrderId   String       @unique
  razorpayPaymentId String?      @unique
  razorpaySignature String?

  amountPaise       Int
  currency          String       @default("INR")
  status            PaymentStatus @default(CREATED)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  verifiedAt        DateTime?

  @@index([userId, createdAt])
}

model WebhookEvent {
  id            String             @id @default(cuid())
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider      String             @default("razorpay")
  eventId       String             @unique
  eventName     String
  orderId       String?
  paymentId     String?
  payloadHash   String
  status        WebhookEventStatus @default(PROCESSING)
  deliveryCount Int                @default(1)
  note          String?
  errorMessage  String?
  processedAt   DateTime?
  lastSeenAt    DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([provider, eventName, createdAt])
  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  userId     String?
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventName  String
  eventType  AnalyticsEventType
  source     String?
  path       String
  locale     String?
  toolSlug   String?
  gameSlug   String?
  sessionId  String?
  ipHash     String?
  userAgent  String?
  metadata   Json?
  occurredAt DateTime           @default(now())
  createdAt  DateTime           @default(now())

  @@index([eventType, occurredAt])
  @@index([path, occurredAt])
  @@index([toolSlug, occurredAt])
  @@index([gameSlug, occurredAt])
  @@index([userId, occurredAt])
}

model AnalyticsPageViewDaily {
  id        String   @id @default(cuid())
  date      DateTime
  path      String
  locale    String?
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, path, locale])
  @@index([date])
}

enum PaymentStatus {
  CREATED
  VERIFIED
  FAILED
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum AnalyticsEventType {
  PAGE_VIEW
  NAV_INTERACTION
  TOOL_USAGE
  GAME_USAGE
  CUSTOM
}
