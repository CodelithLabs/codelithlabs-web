{
  "name": "codelithlabs-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --no-deprecation ./node_modules/next/dist/bin/next dev",
    "dev:trace-deprecations": "node --trace-deprecation ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "og:generate": "node scripts/generate-og-png.mjs",
    "generate-content": "node scripts/generate-tool-content.js",
    "content:auto": "node scripts/generate-tool-content.js",
    "seo:submit": "node scripts/seo-automation.js submit",
    "seo:generate": "node scripts/seo-automation.js generate",
    "seo:status": "node scripts/seo-automation.js status",
    "seo:verify": "node scripts/verify-indexnow.js",
    "seo:audit:h1": "node scripts/seo-audit-h1.js",
    "seo:audit:sitemap": "node scripts/seo-audit-sitemap.js",
    "seo:audit:indexing": "node scripts/seo-audit-indexing.js",
    "seo:audit": "node scripts/seo-audit-trends.js",
    "tools:health": "node scripts/tool-health-audit.js",
    "tools:audit": "node scripts/audit-tool-readiness.js",
    "tools:status": "node scripts/generate-tool-status-map.js",
    "tools:wave1": "node scripts/generate-wave-launch-list.js --wave=1 --size=25",
    "tools:wave2": "node scripts/generate-wave-launch-list.js --wave=2 --size=25",
    "tools:wave2:dedupe": "node scripts/generate-wave-launch-list.js --wave=2 --size=25 --exclude-similar --threshold=2",
    "tools:wave3": "node scripts/generate-wave-launch-list.js --wave=3 --size=25",
    "tools:wave3:dedupe": "node scripts/generate-wave-launch-list.js --wave=3 --size=25 --exclude-similar --threshold=2",
    "tools:wave3:dedupe:quota": "node scripts/generate-wave-launch-list.js --wave=3 --size=25 --exclude-similar --threshold=2 --min-category-quota=1",
    "tools:wave3:dedupe:quota:fallback": "node scripts/generate-wave-launch-list.js --wave=3 --size=25 --exclude-similar --threshold=2 --min-category-quota=1 --progressive-fallback"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@microsoft/clarity": "^1.0.2",
    "@next/bundle-analyzer": "^16.1.6",
    "@next/third-parties": "^16.1.6",
    "@prisma/client": "^6.19.2",
    "@sendgrid/mail": "^8.1.6",
    "@swc/helpers": "0.5.19",
    "@types/qrcode": "^1.5.6",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.36.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.10.0",
    "lucide-react": "^0.330.0",
    "next": "^16.1.5",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.3",
    "pdfjs-dist": "^5.5.207",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-turnstile": "^1.1.5",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "three": "^0.183.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.35",
    "prisma": "^6.19.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
